{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^inside-ones-pensieve\\.vercel\\.app$"
        }
      ],
      "destination": "https://pensiev.me/:path*",
      "permanent": true
    }
  ]
}
